MODULE env
VAR
  next_id : 0..MAX_CLIENTS-1; -- счетчик клиентов

  -- Состояния всех очередей (два массива: одна очередь – отправка, другая – получение)
  q_send    : array 0..M-1 of {empty, occupied};
  q_receive : array 0..M-1 of {empty, occupied};

  -- Признак, что в очереди появился новый клиент (для каждого id)
  client_arrives : array 0..MAX_CLIENTS-1 of boolean;

  -- Признак начала обслуживания клиентом (из окна)
  start_service  : array 0..MAX_CLIENTS-1 of boolean;

  -- Признак окончания обслуживания (по таймеру окна)
  service_done   : array 0..MAX_CLIENTS-1 of boolean;

  -- Сигналы для окон (к какому клиенту обращаться)
  assign_client   : array 0..N-1 of boolean;
  client_to_serve : array 0..N-1 of 0..MAX_CLIENTS-1;
  service_type    : array 0..N-1 of {send, receive};

ASSIGN
  init(next_id) := 0;
  init(client_arrives) := init_array(FALSE);
  init(start_service)  := init_array(FALSE);
  init(service_done)   := init_array(FALSE);
  init(assign_client)  := init_array(FALSE);
  init(client_to_serve) := init_array(0);
  init(service_type)   := init_array(send);

  next(client_arrives) :=
    case
      next_id < MAX_CLIENTS : {TRUE, FALSE};  -- в любой шаг может появиться новый клиент
      TRUE                  : init_array(FALSE);
    esac;

  next(client[id].service) :=
    case
      client_arrives[id] : {send, receive};
      TRUE               : client[id].service;
    esac;  -- случайный выбор запроса клиента

  next(q_send) :=
    case
      client_arrives[id] & client[id].service = send &
      exists i: q_send[i] = empty : set(q_send, i, occupied);
      TRUE : q_send;
    esac;

  next(q_receive) :=
    case
      client_arrives[id] & client[id].service = receive &
      exists i: q_receive[i] = empty : set(q_receive, i, occupied);
      TRUE : q_receive;
    esac;

  -------------------------------------------------
  -- 3. Выбор клиента для окна (политика POLICY)
  -------------------------------------------------
  assign_client := init_array(FALSE);  -- по умолчанию окна ничего не берут

  case
    POLICY = 0 :    -- случайная очередь
      -- Для каждого окна выбираем любой занятый слот случайно
      forall w: 0..N-1 do (
        assign_client[w] := {TRUE, FALSE};
        client_to_serve[w] :=
          case assign_client[w] of
            TRUE  : {  -- выбираем любой клиент из обеих очередей
                       let s := {i | q_send[i]=occupied};
                       let r := {i | q_receive[i]=occupied};
                       if (s != {}) then any(s) else any(r);
                     };
            FALSE : 0;
          esac;
        service_type[w] :=
          case assign_client[w] of
            TRUE  : any({send, receive});  -- случайно, но согласуется с тем, куда мы взяли
            FALSE : send;
          esac;
      );

    POLICY = 1 :    -- выбираем очередь с «самым старым» клиентом
      -- Мы храним в массиве waiting‑timer (client.wait_cnt). Находим max.
      forall w: 0..N-1 do (
        assign_client[w] :=
          (exists i: client[i].state = waiting);
        client_to_serve[w] :=
          case assign_client[w] of
            TRUE  : argmax i in 0..MAX_CLIENTS-1
                              (client[i].state = waiting)  (client[i].wait_cnt);
            FALSE : 0;
          esac;
        service_type[w] :=
          case client[client_to_serve[w]].service of
            send    : send;
            receive : receive;
          esac;
      );
  esac;

  -- Когда окно начинает обслуживать, клиент переходит в state=serving
  next(start_service) := init_array(FALSE);
  next(service_done)  := init_array(FALSE);
  FORALL w IN 0..N-1 DO
    IF assign_client[w] THEN
      start_service[client_to_serve[w]] := TRUE;
    ENDIF;
    IF window[w].busy & window[w].timer=0 THEN
      service_done[window[w].cur_cli] := TRUE;
    ENDIF;
  ENDFOR;
