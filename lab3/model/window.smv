MODULE window(wid)
VAR
  busy      : boolean;
  timer     : 0..max(T_SEND,T_RECEIVE);
  cur_cli   : 0..MAX_CLIENTS-1;

ASSIGN
  init(busy)  := FALSE;
  init(timer) := 0;
  init(cur_cli):= 0;

  next(busy) :=
    case
      !busy & env.assign_client[wId] : TRUE;
      busy & timer = 0                : FALSE;
      TRUE                            : busy;
    esac;

  next(timer) :=
    case
      !busy & env.assign_client[wId] : 
           case env.service_type[wId] of
                send    : T_SEND;
                receive : T_RECEIVE;
           esac;
      busy & timer > 0               : timer - 1;
      TRUE                           : timer;
    esac;

  next(cur_cli) :=
    case
      !busy & env.assign_client[wId] : env.client_to_serve[wId];
      TRUE                           : cur_cli;
    esac;
